[Unit]
Description=skech relayer on Solana: prices, attests and sends every Solana transaction, on :3104
After=network-online.target skech-engine.service
Wants=network-online.target skech-engine.service
# Only once the box has a Solana cluster and key (infra/deploy.sh --env ships them).
ConditionPathExists=/etc/skech/solana

[Service]
User=skech
WorkingDirectory=/opt/skech
EnvironmentFile=/etc/skech/env
Environment=NEXT_PUBLIC_ENGINE_URL=ws://127.0.0.1:3102/ws
ExecStart=/home/skech/.bun/bin/bun packages/relayer/src/solana/index.ts
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
