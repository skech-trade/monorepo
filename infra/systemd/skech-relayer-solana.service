[Unit]
Description=skech relayer on Solana: prices, attests and sends every Solana transaction, on :3104
After=network-online.target skech-engine.service
Wants=network-online.target skech-engine.service
# Only once the box has a Solana cluster and key (infra/deploy.sh --env ships them).
ConditionPathExists=/etc/skech/solana
# A crash loop gives up after this many starts in ten minutes, rather than spin: `systemctl reset-failed` to go again.
StartLimitIntervalSec=600
StartLimitBurst=50

[Service]
# The Monad relayer's user: they share the env file and the state directory.
User=skech-relayer
Group=skech-relayer
WorkingDirectory=/opt/skech
EnvironmentFile=/etc/skech/relayer.env
Environment=NEXT_PUBLIC_ENGINE_URL=ws://127.0.0.1:3102/ws
StateDirectory=skech-relayer
StateDirectoryMode=0750
Environment=RELAYER_STATE_DIR=/var/lib/skech-relayer
CacheDirectory=skech-relayer
Environment=HOME=/var/cache/skech-relayer XDG_CACHE_HOME=/var/cache/skech-relayer BUN_RUNTIME_TRANSPILER_CACHE_PATH=/var/cache/skech-relayer
ExecStart=/usr/local/bin/bun packages/relayer/src/solana/index.ts
Restart=always
RestartSec=2
LimitNOFILE=65536
MemoryMax=400M

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
