[Unit]
Description=skech engine: signed BTC-USD prices on :3102
After=network-online.target
Wants=network-online.target

[Service]
User=skech
# Run from the repo root so the engine finds packages/evm-contracts/deployments/<chain>.json.
WorkingDirectory=/opt/skech
EnvironmentFile=/etc/skech/env
# Sentry reports only where this is set; a laptop has none (packages/engine/README.md).
Environment=SENTRY_ENVIRONMENT=production
ExecStart=/opt/skech/packages/engine/target/release/engine
# panic = "abort": a dead feed ends the process, and this brings it back.
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
