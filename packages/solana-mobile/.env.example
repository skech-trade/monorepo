# The Coinbase Developer Platform project (portal.cdp.coinbase.com): the embedded wallet, signed in by email.
EXPO_PUBLIC_CDP_PROJECT_ID=
# Where the app reaches the engine (prices) and the Solana relayer. The box:
#   wss://api.skech.trade/engine/ws   and   wss://api.skech.trade/solana/ws
# On a simulator, the Mac's own: ws://localhost:3102/ws and ws://localhost:3104/ws
# (on the Android emulator, 10.0.2.2 instead of localhost).
EXPO_PUBLIC_ENGINE_URL=wss://api.skech.trade/engine/ws
EXPO_PUBLIC_RELAYER_URL=wss://api.skech.trade/solana/ws
# Public social service (Solana profiles/history). The Postgres secret stays on the server.
# Android emulator development: http://10.0.2.2:3106
EXPO_PUBLIC_SOCIAL_URL=https://api.skech.trade/social-solana
