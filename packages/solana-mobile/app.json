{
  "expo": {
    "name": "skech",
    "slug": "skech",
    "scheme": "skech",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "trade.skech.app",
      "supportsTablet": true,
      "infoPlist": { "NSCameraUsageDescription": "To scan an address to withdraw to." }
    },
    "android": {
      "package": "trade.skech.app",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#ffffff" },
      "permissions": ["android.permission.CAMERA", "android.permission.VIBRATE"]
    },
    "web": { "output": "static" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset",
      "expo-font",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your skech profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      ["expo-camera", { "cameraPermission": "To scan an address to withdraw to.", "recordAudioAndroid": false }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
