{
  "name": "@skech/contracts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "forge build && bun run abi",
    "test": "forge test",
    "abi": "forge build --silent && for c in SkechGame SkechIOU SkechRevenue; do forge inspect $c abi --json > abi/$c.json; done",
    "test:check": "FORGE_SNAPSHOT_CHECK=true forge test"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2"
  }
}
