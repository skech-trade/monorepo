# Copy to .env.local and fill in. .env and .env*.local are gitignored at the
# repo root, which covers every workspace under it. Never commit real values,
# and never give a secret a NEXT_PUBLIC_ name: that prefix ships it to the
# browser in the page source.

# ---- Lighter -----------------------------------------------------------------
# testnet: https://testnet.zklighter.elliot.ai   (chain id 300)
# mainnet: https://mainnet.zklighter.elliot.ai
LIGHTER_BASE_URL=https://testnet.zklighter.elliot.ai

# The account the server trades for. An index, not an address.
LIGHTER_ACCOUNT_INDEX=

# Which of the account's API keys this key is. 0 to 3 are reserved by Lighter's
# own clients, so ours start at 4. Keep 5 free for a browser-held key later.
LIGHTER_API_KEY_INDEX=4

# The trading key. It signs orders, and it can sign a withdrawal to the
# account's own L1 address, so it can lose money even though it cannot move it
# to a stranger. Server side only, and in production it belongs in a secrets
# manager decrypted inside the trader process, not in a file.
LIGHTER_PRIVATE_KEY=

# Reads only, applied for in Lighter's Discord. A Standard key has effectively
# no read budget, so every poll goes through this one.
LIGHTER_BUILDER_ACCOUNT_INDEX=

# For the UDA deposit bridge, also from Lighter's Discord.
LIGHTER_BRIDGE_API_KEY=

# ---- Coinbase CDP embedded wallets -------------------------------------------
# The project id and client key are meant to reach the browser. The key id and
# secret are not.
#
# Before any of it works, the app's origin has to be allowlisted in the CDP
# Portal under Clients Configuration, "Add domain". For local work that is
# http://localhost:3101. Without it the SDK answers "Failed to get project
# config" and the sign-in panel comes up blank.
NEXT_PUBLIC_CDP_PROJECT_ID=
NEXT_PUBLIC_CDP_CLIENT_API_KEY=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ---- The app ------------------------------------------------------------------
# Where services/feed is. Unset, Draw runs on its simulation.
NEXT_PUBLIC_FEED_URL=http://localhost:3210

# ---- Landing -----------------------------------------------------------------
# The Apps Script endpoint the waitlist posts to. An open write endpoint, so it
# stays server side: never NEXT_PUBLIC_.
WAITLIST_SHEET_URL=
