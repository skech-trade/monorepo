# Copy to .env.local and fill in. .env and .env*.local are gitignored at the
# repo root, which covers every workspace under it. Never commit real values,
# and never give a secret a NEXT_PUBLIC_ name: that prefix ships it to the
# browser in the page source.
#
#   cp .env.example .env.local
#
# ui/app pulls only NEXT_PUBLIC_* out of the same file via next.config.ts
# (Next only looks in its own dir). On Vercel there is no root file, so set
# the NEXT_PUBLIC_* names in the Vercel project instead.

# ---- Coinbase CDP embedded wallets -------------------------------------------
# The project id and client key are meant to reach the browser. The key id and
# secret are not.
#
# Before any of it works, the app's origin has to be allowlisted in the CDP
# Portal under Clients Configuration, "Add domain". For local work that is
# http://localhost:3101. Without it the SDK answers "Failed to get project
# config" and the sign-in panel comes up blank.
NEXT_PUBLIC_CDP_PROJECT_ID=
# Handed to you next to the project id in the CDP portal. Nothing reads it;
# kept here so nobody goes looking for where it goes.
NEXT_PUBLIC_CDP_CLIENT_API_KEY=
# The server key pair from the same portal. Nothing in the repo reads these yet either; secret, never NEXT_PUBLIC_.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ---- Sentry (ui/app) -------------------------------------------------------------
# Errors, traces and a replay of the minute before each error (ui/app/src/lib/sentry.ts).
# The DSN only lets a browser send events, so it may be public. Blank: Sentry is off.
# Off in `next dev` too, unless NEXT_PUBLIC_SENTRY_DEV=1.
NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DEV=1
# Uploads source maps at build, so stacks read as our source. Build-time only, a secret:
# set it in the Vercel project (Sentry > Settings > Auth Tokens), never NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=

# ---- Analytics (ui/app): PostHog ------------------------------------------------
# The project's key from PostHog → Settings → Project: public by design, it only writes events.
# Blank: no analytics at all. Events go through /ingest on the app's own domain (next.config.ts).
# What is sent, and why each event, is in ui/app/src/lib/analytics.ts.
NEXT_PUBLIC_POSTHOG_KEY=
# us or eu, whichever the project was made in. Blank: us.
NEXT_PUBLIC_POSTHOG_REGION=
# 1 to send from `bun run dev` too. Blank: only production builds send, so a laptop never spends the free plan.
NEXT_PUBLIC_POSTHOG_DEV=

# ---- Landing (ui/landing, server-only) ----------------------------------------
# The Apps Script endpoint the waitlist posts to. An open write endpoint, so it
# stays server side: never NEXT_PUBLIC_.
WAITLIST_SHEET_URL=

# ---- Network (everything) ---------------------------------------------------------
# testnet or mainnet; blank is testnet. The one switch: it picks the chain (10143 or 143),
# Circle's USDC, the public RPC and, on testnet, the faucet link players see, for the
# engine, the relayer, the deploy script and the app. Each finds its game in
# packages/evm-contracts/deployments/<chainId>.json, so switching is this one line.
SKECH_NETWORK=testnet
# Overrides for a local anvil run only (bun packages/relayer/scripts/e2e.ts sets them itself).
# ENGINE_CHAIN_ID may not name the other network: SKECH_NETWORK=mainnet with 10143 is refused.
# ENGINE_CHAIN_ID=
# ENGINE_VERIFYING_CONTRACT=
# SKECH_GAME=
# The relayer's other addresses, for the same anvil run: each defaults to the deployment file.
# SKECH_IOU=
# SKECH_REVENUE=
# SKECH_USDC=
# SKECH_LIB=
# A private RPC per network for the relayer and deploys. Blank: Monad's public RPC, which allows
# 15 requests a second: enough to try things, not for players. A QuickNode endpoint works (about
# 50 a second); with QUICK_NODE_API_KEY one can be made through QuickNode's admin API:
# POST https://api.quicknode.com/v0/endpoints {"chain":"monad","network":"monad-testnet"} (or monad-mainnet).
# Its URL carries its token: server-only, never a NEXT_PUBLIC_ name. MONAD_RPC_URL overrides both.
MONAD_TESTNET_RPC_URL=
MONAD_MAINNET_RPC_URL=
# MONAD_RPC_URL=
# QuickNode's admin API key: makes and lists endpoints. Server-only.
QUICK_NODE_API_KEY=
# The relayer signs quotes and bars and pays gas. Blank: ENGINE_PRIVATE_KEY, which is the
# same wallet for now (it must be the game's oracle either way). Keep it topped up: Monad
# holds 10 MON of every account in reserve, and gas is charged on the limit, not what is used.
RELAYER_PRIVATE_KEY=
# RELAYER_PORT=3103
# One gas-limited send in this many is also estimated alongside, to check the gas model. Blank: 5; 1 checks all.
# RELAYER_SHADOW_EVERY=5
# The relayer's Sentry project (packages/relayer/src/sentry.ts): crashes, and pieces not placed, seconds
# not settled, the sweep, the state file and low MON, at most once an hour each. Blank: off. Only under
# systemd on the box, unless RELAYER_SENTRY_DEV=1. infra/deploy.sh --env ships it.
RELAYER_SENTRY_DSN=
# RELAYER_SENTRY_DEV=1
# Where the app reaches the relayer. Blank: ws://localhost:3103/ws, which is right only for `bun run dev`.
# Built into the page at build time: on Vercel set it for Production (and Preview), then redeploy.
# The box: wss://api.skech.trade/relayer/ws
NEXT_PUBLIC_RELAYER_URL=
# The app's chain, game and USDC come from SKECH_NETWORK and the deployment file (next.config.ts).
# The browser's RPC: public, since anything here ships to every player. Blank: Monad's public RPC.
NEXT_PUBLIC_MONAD_RPC_URL=

# ---- Engine (packages/engine, server-only) -------------------------------------
# The wallet that signs quotes. Blank: a throwaway wallet each run.
ENGINE_PRIVATE_KEY=
# It signs under the EIP-712 domain of SKECH_NETWORK's chain and the game deployed there.
# How far Binance and Kraken's median may be from Coinbase before their price
# is signed instead, in basis points. Blank: 1 (0.01%).
ENGINE_BAND_BPS=
# ENGINE_PORT=3102
# Sentry: a panic, with its stack, before the engine goes down. Sent only where SENTRY_ENVIRONMENT
# is set (the box's unit sets production), or with ENGINE_SENTRY_DEV=1.
ENGINE_SENTRY_DSN=
# ENGINE_SENTRY_DEV=1
# Where the app reaches the engine. Blank: ws://localhost:3102/ws, which is right only for `bun run dev`.
# Built into the page at build time: on Vercel set it for Production (and Preview), then redeploy.
# The box: wss://api.skech.trade/engine/ws
NEXT_PUBLIC_ENGINE_URL=
