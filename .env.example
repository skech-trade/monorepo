# Copy to .env.local and fill in. .env and .env*.local are gitignored at the
# repo root, which covers every workspace under it. Never commit real values,
# and never give a secret a NEXT_PUBLIC_ name: that prefix ships it to the
# browser in the page source.
#
#   cp .env.example .env.local
#   docker compose --env-file .env.local up db   # Postgres on :5432
#
# Services read the root file via `--env-file` in their dev scripts.
# ui/app pulls only NEXT_PUBLIC_* out of the same file via next.config.ts
# (Next only looks in its own dir). On Vercel there is no root file, so set
# the NEXT_PUBLIC_* names in the Vercel project instead.

# ---- Network switch ----------------------------------------------------------
# One switch, read by every service and the browser. testnet is the safe
# default: orders sign and settle for real, with money that is not.
# The two names must match or the app quotes one venue while the API answers
# for another.
SKECH_NETWORK=testnet
NEXT_PUBLIC_SKECH_NETWORK=testnet

# ---- Lighter (trader) --------------------------------------------------------
# testnet: https://testnet.zklighter.elliot.ai   (chain id 300, BTC market 4096)
# mainnet: https://mainnet.zklighter.elliot.ai   (chain id 304, BTC market 1)
#
# The network picks the credential as well as the venue. Testnet keys sign
# when SKECH_NETWORK=testnet, mainnet keys when it says mainnet.

# The account the server trades for. An index, not an address.
LIGHTER_ACCOUNT_INDEX=
# Which of the account's API keys this key is. 0 to 3 are reserved by Lighter's
# own clients, so ours start at 4. Keep 5 free for a browser-held key later.
LIGHTER_API_KEY_INDEX=4
# The trading key. It signs orders, and it can sign a withdrawal to the
# account's own L1 address, so it can lose money even though it cannot move it
# to a stranger. Server side only, and in production it belongs in a secrets
# manager decrypted inside the trader process, not in a file.
LIGHTER_PRIVATE_KEY=

# Same three, used when SKECH_NETWORK=mainnet.
LIGHTER_MAINNET_ACCOUNT_INDEX=
LIGHTER_MAINNET_API_KEY_INDEX=4
LIGHTER_MAINNET_PRIVATE_KEY=

# Which slot skech registers per-wallet keys into. Zero is what most clients
# take first. (services/trader/src/keys.ts, default 2)
LIGHTER_USER_KEY_INDEX=2

# Explicit venue URL override. Unset, each service uses VENUE[SKECH_NETWORK].
# The API deliberately keeps this on mainnet even when the trader is on
# testnet: a testnet deposit address shown as "send USDC here" loses real money.
LIGHTER_API_URL=https://mainnet.zklighter.elliot.ai

# Reads only, applied for in Lighter's Discord. A Standard key has effectively
# no read budget, so every poll goes through this one.
LIGHTER_BUILDER_ACCOUNT_INDEX=
# For the UDA deposit bridge, also from Lighter's Discord.
LIGHTER_BRIDGE_API_KEY=

# Path to the native signer shim. Unset, the trader uses
# services/trader/native/vendor/shim.{dylib,so}. Docker sets this to
# /srv/native/vendor/shim.so itself.
# LIGHTER_SHIM=

# ---- Feed (services/feed) ----------------------------------------------------
# Prices always come from mainnet: testnet reports a mark but does not trade,
# so a chart built from it is a flat line.
LIGHTER_WS=wss://mainnet.zklighter.elliot.ai/stream
LIGHTER_MARKET_ID=1

# ---- API (services/api) ------------------------------------------------------
# Postgres. `docker compose --env-file .env.local up db` gives you one at this
# URL. Unset, the API still starts and answers, with no name on anybody; the
# trader holds its keys in memory and /health says "memory only, lost on restart".
DATABASE_URL=postgres://skech:skech@localhost:5432/skech
# Bridge quotes for deposits. (services/api/src/deposit.ts)
RELAY_URL=https://api.relay.link

# ---- Services infra ----------------------------------------------------------
# CORS origin for feed / api / trader. Default *; set to the app origin
# (e.g. https://app.your-domain.com) once there is real money behind it.
ALLOW_ORIGIN=*
# Per-service ports. Defaults: feed 3210, trader 3220, api 3230. Normally left
# unset in this file; Docker and `bun run dev:*` already know them.
# PORT=

# ---- The app (ui/app, browser-safe) ------------------------------------------
# Where services/feed is. Unset, Draw runs on its simulation.
NEXT_PUBLIC_FEED_URL=http://localhost:3210
# Where services/api is. Unset, there is no name and no real balance.
NEXT_PUBLIC_API_URL=http://localhost:3230
# Where services/trader is. Unset, rounds still run against real prices with
# no position behind them, and the screen says so. A round that quietly did
# not trade would be the worst of both.
NEXT_PUBLIC_TRADER_URL=http://localhost:3220

# ---- Coinbase CDP embedded wallets -------------------------------------------
# The project id and client key are meant to reach the browser. The key id and
# secret are not.
#
# Before any of it works, the app's origin has to be allowlisted in the CDP
# Portal under Clients Configuration, "Add domain". For local work that is
# http://localhost:3101. Without it the SDK answers "Failed to get project
# config" and the sign-in panel comes up blank.
NEXT_PUBLIC_CDP_PROJECT_ID=
# Handed to you next to the project id in the CDP portal. Nothing reads it;
# kept here so nobody goes looking for where it goes.
NEXT_PUBLIC_CDP_CLIENT_API_KEY=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ---- Landing (ui/landing, server-only) ----------------------------------------
# The Apps Script endpoint the waitlist posts to. An open write endpoint, so it
# stays server side: never NEXT_PUBLIC_.
WAITLIST_SHEET_URL=
