{
  "name": "skech",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "ui/*",
    "services/*"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:landing": "bun run --filter @skech/landing dev",
    "dev:app": "bun run --filter @skech/app dev",
    "build": "bun run --filter '*' build",
    "start": "bun run --filter '*' start",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "clean": "rm -rf node_modules ui/*/node_modules ui/*/.next",
    "dev:feed": "bun run --filter @skech/feed dev",
    "test": "bun run --filter '*' test",
    "dev:trader": "bun run --filter @skech/trader dev",
    "docker": "docker compose up --build feed",
    "dev:api": "bun run --filter @skech/api dev"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
