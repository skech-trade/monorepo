{
  "name": "@skech/trader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:native": "./native/build.sh",
    "dev": "bun --watch --env-file=../../.env.local src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench:cpu": "bun bench/cpu.ts",
    "bench:network": "bun bench/network.ts",
    "bench": "bun bench/cpu.ts && bun bench/network.ts",
    "boost:setup": "bun --env-file=../../.env.local scripts/boost-setup.ts",
    "boost:e2e": "bun --env-file=../../.env.local scripts/boost-e2e.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5"
  },
  "dependencies": {
    "@skech/core": "workspace:*",
    "viem": "2.56.8"
  }
}
